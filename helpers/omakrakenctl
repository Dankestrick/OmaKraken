#!/usr/bin/env python3
"""omakrakenctl - talk to the Razer Kraken V3 Pro's wireless dongle (USB 1532:052c).

The dongle's settings channel is a CDC serial port (/dev/ttyACMn). Every
command is a 28-byte Bluetooth HCI vendor packet:

    01 f3 ff 18 | 02 <21 write / 20 read> <b6> <b7 .. b26> <checksum>

checksum = -(sum of bytes 7..26) & 0xff. The headset answers each one with an
HCI "command complete" event: 04 0e 1c 01 f3 ff <status> <echo...>.

Commands:
    omakrakenctl run      Long-running mode used by the Omarchy shell. Reads one
                          JSON command per line on stdin, prints one JSON status
                          line on stdout whenever something changes. Runs the
                          lighting effects, since the headset has none of its own.
    omakrakenctl status   Read the headset once and print JSON (for a terminal).

Only standard-library Python. No network, no root.
"""

import errno
import fcntl
import glob
import json
import math
import os
import re
import select
import signal
import stat
import struct
import sys
import tempfile
import termios
import time

VENDOR = "1532"
PRODUCT = "052c"
FRAME_LEN = 28
MAX_STDIN_LINE = 4096
MAX_BUFFER = 4096

READ_TIMEOUT = 0.6      # seconds to wait for a reply
POLL_SECONDS = 60       # battery and state poll while idle
FAST_POLL_SECONDS = 5   # while the dropdown is open
RETRY_SECONDS = 10      # reopen the port after it went away
STATIC_KEEPALIVE = 5.0  # Synapse repeats a static colour every 5 s
EFFECT_FPS = 25         # Synapse streams effects at about 25 frames a second
MISSES_BEFORE_UNAVAILABLE = 3

EFFECTS = ("static", "breathing", "spectrum")

DEFAULTS = {
    "lighting": True,
    "effect": "static",
    "color": "#00ff00",
    "brightness": 100,   # percent
    "speed": 5,          # 1-10, breathing and spectrum
    "haptics": True,
    "hapticsLevel": 1,   # 1 low, 2 medium, 3 high
}

TIOCMBIS = 0x5416
TIOCM_DTR = 0x002
TIOCM_RTS = 0x004


def config_dir():
    base = os.environ.get("XDG_CONFIG_HOME") or os.path.join(os.path.expanduser("~"), ".config")
    return os.path.join(base, "omakraken")


def runtime_dir():
    base = os.environ.get("XDG_RUNTIME_DIR")
    if base and os.path.isdir(base):
        return os.path.join(base, "omakraken")
    base = os.environ.get("XDG_CACHE_HOME") or os.path.join(os.path.expanduser("~"), ".cache")
    return os.path.join(base, "omakraken")


def private_dir(path):
    os.makedirs(path, mode=0o700, exist_ok=True)
    st = os.lstat(path)
    if not stat.S_ISDIR(st.st_mode) or st.st_uid != os.getuid():
        raise OSError("%s is not a folder owned by you" % path)
    if stat.S_IMODE(st.st_mode) != 0o700:
        os.chmod(path, 0o700)
    return path


# ---------------------------------------------------------------------------
# Settings the headset cannot report back (lighting, haptics). They are kept
# in ~/.config/omakraken/settings.json and sent to the headset on connect.
# A file that exists but cannot be read is never overwritten.

class Settings:
    def __init__(self):
        self.path = os.path.join(config_dir(), "settings.json")
        self.values = dict(DEFAULTS)
        self.writable = True
        self.problem = ""
        try:
            with open(self.path, "rb") as f:
                raw = f.read(65536 + 1)
            if len(raw) > 65536:
                raise ValueError("file is too large")
            data = json.loads(raw.decode("utf-8"))
            if not isinstance(data, dict):
                raise ValueError("not a JSON object")
            for key, value in data.items():
                if key in DEFAULTS:
                    try:
                        self.values[key] = validate(key, value)
                    except ValueError:
                        pass
        except FileNotFoundError:
            pass
        except (OSError, ValueError, UnicodeDecodeError) as e:
            self.writable = False
            self.problem = "%s could not be read (%s). Settings are not being saved; fix or move that file." % (
                self.path, e)

    def save(self):
        if not self.writable:
            return
        folder = private_dir(config_dir())
        fd, tmp = tempfile.mkstemp(prefix=".settings.", suffix=".json", dir=folder)
        try:
            with os.fdopen(fd, "w") as f:
                json.dump(self.values, f, indent=2, sort_keys=True)
                f.write("\n")
            os.chmod(tmp, 0o600)
            os.replace(tmp, self.path)
        except BaseException:
            try:
                os.unlink(tmp)
            except OSError:
                pass
            raise


def validate(key, value):
    """Return a clean value for a setting, or raise ValueError."""
    if key in ("lighting", "haptics", "sidetone", "powerSaving"):
        if isinstance(value, bool):
            return value
        raise ValueError("%s must be true or false" % key)
    if key == "effect":
        if value in EFFECTS:
            return value
        raise ValueError("unknown effect")
    if key == "color":
        if isinstance(value, str) and re.fullmatch(r"#[0-9a-fA-F]{6}", value):
            return value.lower()
        raise ValueError("color must look like #rrggbb")
    ranges = {"brightness": (0, 100), "speed": (1, 10), "hapticsLevel": (1, 3),
              "sidetoneLevel": (0, 4), "powerSavingMinutes": (15, 60)}
    if key in ranges:
        if isinstance(value, bool) or not isinstance(value, (int, float)):
            raise ValueError("%s must be a number" % key)
        lo, hi = ranges[key]
        return int(max(lo, min(hi, round(value))))
    raise ValueError("unknown setting %s" % key)


# ---------------------------------------------------------------------------
# Device discovery and framing

def dongle_present():
    for d in glob.glob("/sys/bus/usb/devices/*"):
        try:
            with open(os.path.join(d, "idVendor")) as f:
                vendor = f.read(16).strip()
            with open(os.path.join(d, "idProduct")) as f:
                product = f.read(16).strip()
        except OSError:
            continue
        if vendor == VENDOR and product == PRODUCT:
            return True
    return False


def find_port():
    """The /dev/ttyACMn that belongs to the Kraken dongle, or None."""
    for tty in sorted(glob.glob("/sys/class/tty/ttyACM*")):
        name = os.path.basename(tty)
        if not re.fullmatch(r"ttyACM[0-9]{1,3}", name):
            continue
        dev = os.path.realpath(os.path.join(tty, "device"))
        # The tty's device is a USB interface; its parent is the USB device.
        usb = os.path.dirname(dev)
        try:
            with open(os.path.join(usb, "idVendor")) as f:
                vendor = f.read(16).strip()
            with open(os.path.join(usb, "idProduct")) as f:
                product = f.read(16).strip()
        except OSError:
            continue
        if vendor == VENDOR and product == PRODUCT:
            return "/dev/" + name
    return None


def frame(write, b6, rest=b""):
    f = bytearray(FRAME_LEN)
    f[0:6] = bytes([0x01, 0xf3, 0xff, 0x18, 0x02, 0x21 if write else 0x20])
    f[6] = b6
    f[7:7 + len(rest)] = rest
    f[27] = (-sum(f[7:27])) & 0xff
    return bytes(f)


def hex_rgb(color):
    return int(color[1:3], 16), int(color[3:5], 16), int(color[5:7], 16)


def hue_rgb(h):
    x = (h % 1.0) * 6
    i = int(x)
    f = x - i
    r, g, b = [(1, f, 0), (1 - f, 1, 0), (0, 1, f), (0, 1 - f, 1), (f, 0, 1), (1, 0, 1 - f)][i % 6]
    return int(r * 255), int(g * 255), int(b * 255)


class Unavailable(Exception):
    pass


class Port:
    """The dongle's serial port. Every call is non-blocking with a deadline,
    and closing discards unsent output, so a jammed dongle cannot hang us."""

    def __init__(self, path):
        self.path = path
        self.fd = os.open(path, os.O_RDWR | os.O_NOCTTY | os.O_NONBLOCK | os.O_CLOEXEC)
        try:
            attrs = termios.tcgetattr(self.fd)
            attrs[0] = attrs[1] = attrs[3] = 0
            attrs[2] = termios.CS8 | termios.CREAD | termios.CLOCAL
            attrs[6][termios.VMIN] = 0
            attrs[6][termios.VTIME] = 0
            termios.tcsetattr(self.fd, termios.TCSANOW, attrs)
            fcntl.ioctl(self.fd, TIOCMBIS, struct.pack("I", TIOCM_DTR | TIOCM_RTS))
            termios.tcflush(self.fd, termios.TCIOFLUSH)
        except BaseException:
            os.close(self.fd)
            raise
        self.buf = b""

    def close(self):
        if self.fd is None:
            return
        try:
            termios.tcflush(self.fd, termios.TCIOFLUSH)
        except OSError:
            pass
        try:
            os.close(self.fd)
        except OSError:
            pass
        self.fd = None

    def send(self, data):
        try:
            n = os.write(self.fd, data)
        except BlockingIOError:
            raise Unavailable("the dongle is not taking commands")
        except OSError as e:
            raise Unavailable(e.strerror or str(e))
        if n != len(data):
            raise Unavailable("the dongle is not taking commands")

    def pump(self):
        """Read whatever is waiting. Keeps at most MAX_BUFFER bytes."""
        while True:
            try:
                chunk = os.read(self.fd, 512)
            except BlockingIOError:
                return
            except OSError as e:
                raise Unavailable(e.strerror or str(e))
            if not chunk:
                return
            self.buf = (self.buf + chunk)[-MAX_BUFFER:]

    def events(self):
        """Complete HCI events from the buffer."""
        out = []
        while True:
            start = self.buf.find(b"\x04")
            if start < 0:
                self.buf = b""
                return out
            self.buf = self.buf[start:]
            if len(self.buf) < 3:
                return out
            need = 3 + self.buf[2]
            if len(self.buf) < need:
                return out
            out.append(self.buf[:need])
            self.buf = self.buf[need:]

    def read_value(self, cmd, timeout=READ_TIMEOUT):
        """Send read `cmd` and return the reply's value bytes (after the echo)."""
        self.pump()
        self.events()
        self.send(frame(False, cmd))
        deadline = time.monotonic() + timeout
        while time.monotonic() < deadline:
            r, _, _ = select.select([self.fd], [], [], max(0, deadline - time.monotonic()))
            if r:
                self.pump()
            for ev in self.events():
                # 04 0e 1c 01 f3 ff <status> 02 20 <cmd> <values...>
                if len(ev) >= 10 and ev[1] == 0x0e and ev[4:6] == b"\xf3\xff" and ev[8] == 0x20 and ev[9] == cmd:
                    if ev[6] != 0:
                        raise Unavailable("the headset refused the request")
                    return ev[10:]
        raise Unavailable("the headset did not answer")

    def write(self, b6, rest=b""):
        """Send a write. Replies are drained later; lighting streams too fast to wait on each one."""
        self.pump()
        self.events()
        self.send(frame(True, b6, rest))


# ---------------------------------------------------------------------------
# Reading and writing the headset

def read_state(port):
    battery_reply = port.read_value(0x24)
    sidetone = port.read_value(0x25)
    power = port.read_value(0x26)
    return {
        "battery": int(battery_reply[3]),
        "signal": int(battery_reply[2]),
        "sidetone": bool(sidetone[0]),
        "sidetoneLevel": int(min(4, sidetone[1])),
        "powerSaving": bool(power[0]),
        "powerSavingMinutes": int(max(15, min(60, round((power[1] | power[2] << 8) / 60)))),
    }


def read_serial(port):
    raw = port.read_value(0x21)
    text = raw.split(b"\x00", 1)[0].decode("ascii", "replace")
    return "".join(c for c in text if c.isalnum())[:32]


def send_brightness(port, percent):
    port.write(0x40, bytes([0x8e, 0x00, 0x00, int(round(percent * 255 / 100))]))


def send_color(port, rgb):
    r, g, b = rgb
    port.write(0x40, bytes([0x8c, 0x00, 0x00, 0x08, 0x01, r, g, b]))


def send_haptics(port, on, level):
    port.write(0x40, bytes([0x8a, 0x00, 0x01 if on else 0x00, level]))


def send_sidetone(port, on, level):
    port.write(0x25, bytes([0x01 if on else 0x00, level]))


def send_power_saving(port, on, minutes):
    secs = minutes * 60
    port.write(0x26, bytes([0x01 if on else 0x00, secs & 0xff, secs >> 8]))


# ---------------------------------------------------------------------------
# Long-running mode

class Runner:
    def __init__(self, apply=True):
        # `status` only reads; `run` also sends the saved lighting and haptics.
        self.apply = apply
        self.settings = Settings()
        self.port = None
        self.state = {}
        self.serial = ""
        self.error = self.settings.problem
        self.misses = 0
        self.last_open_try = 0.0
        self.next_poll = 0.0
        self.fast = False
        self.effect_start = time.monotonic()
        self.next_frame = 0.0
        self.last_printed = ""
        self.stdin_buf = b""
        self.stop = False
        # Checked on each poll and open attempt, not on every loop pass.
        self.dongle = dongle_present()

    # -- output ------------------------------------------------------------
    def status(self):
        s = {
            "dongle": self.dongle,
            "connected": self.port is not None and bool(self.state),
            "port": self.port.path if self.port else "",
            "serial": self.serial,
            "settings": dict(self.settings.values),
            "error": self.error[:300],
        }
        s.update(self.state)
        return s

    def emit(self, force=False):
        line = json.dumps(self.status(), sort_keys=True)
        if force or line != self.last_printed:
            self.last_printed = line
            sys.stdout.write(line + "\n")
            sys.stdout.flush()

    # -- port lifecycle ----------------------------------------------------
    def drop(self, why):
        if self.port:
            self.port.close()
        self.port = None
        self.state = {}
        self.error = why
        self.misses = 0

    def try_open(self):
        now = time.monotonic()
        if now - self.last_open_try < RETRY_SECONDS:
            return
        self.last_open_try = now
        self.dongle = dongle_present()
        path = find_port()
        if not path:
            self.error = "" if not self.dongle else "The dongle's settings port is missing."
            return
        try:
            self.port = Port(path)
        except PermissionError:
            self.error = "No permission to open %s. Install the udev rule (see the README), then replug the dongle." % path
            return
        except OSError as e:
            self.error = "Could not open %s: %s" % (path, e.strerror or e)
            return
        try:
            self.serial = read_serial(self.port)
            self.state = read_state(self.port)
            self.error = self.settings.problem
            if self.apply:
                self.apply_all()
        except Unavailable as e:
            self.drop("The headset is not answering (%s). Turn it on, or replug the dongle if it stays like this." % e)
        self.next_poll = time.monotonic() + self.poll_interval()

    def poll_interval(self):
        return FAST_POLL_SECONDS if self.fast else POLL_SECONDS

    def poll(self):
        self.dongle = dongle_present()
        try:
            self.state = read_state(self.port)
            self.misses = 0
            self.error = self.settings.problem
        except Unavailable as e:
            self.misses += 1
            if self.misses >= MISSES_BEFORE_UNAVAILABLE:
                self.drop("The headset is not answering (%s). Turn it on, or replug the dongle if it stays like this." % e)
        self.next_poll = time.monotonic() + self.poll_interval()

    # -- applying settings -------------------------------------------------
    def apply_all(self):
        v = self.settings.values
        send_haptics(self.port, v["haptics"], v["hapticsLevel"])
        self.apply_lighting()

    def apply_lighting(self):
        v = self.settings.values
        send_brightness(self.port, v["brightness"] if v["lighting"] else 0)
        self.effect_start = time.monotonic()
        self.next_frame = 0.0
        self.effect_frame()

    def effect_frame(self):
        """Send the current effect's colour if it is due. Returns seconds until the next one."""
        v = self.settings.values
        now = time.monotonic()
        if not v["lighting"]:
            return None
        if now < self.next_frame:
            return self.next_frame - now
        t = now - self.effect_start
        speed = v["speed"]
        if v["effect"] == "static":
            rgb = hex_rgb(v["color"])
            interval = STATIC_KEEPALIVE
        elif v["effect"] == "breathing":
            period = 11.0 - speed          # 10 s at speed 1, 1 s at speed 10
            level = (1 - math.cos(2 * math.pi * t / period)) / 2
            r, g, b = hex_rgb(v["color"])
            rgb = (int(r * level), int(g * level), int(b * level))
            interval = 1.0 / EFFECT_FPS
        else:  # spectrum
            period = 2.0 * (11.0 - speed)  # 20 s per cycle at speed 1, 2 s at speed 10
            rgb = hue_rgb(t / period)
            interval = 1.0 / EFFECT_FPS
        send_color(self.port, rgb)
        self.next_frame = now + interval
        return interval

    def set(self, key, value):
        value = validate(key, value)
        if key in ("sidetone", "sidetoneLevel", "powerSaving", "powerSavingMinutes"):
            if not self.port or not self.state:
                raise Unavailable("the headset is not connected")
            s = dict(self.state)
            s[key] = value
            if key.startswith("sidetone"):
                send_sidetone(self.port, s["sidetone"], s["sidetoneLevel"])
            else:
                send_power_saving(self.port, s["powerSaving"], s["powerSavingMinutes"])
            # The headset reports these itself; read them back.
            self.state = read_state(self.port)
            return
        self.settings.values[key] = value
        self.settings.save()
        if self.port and self.state:
            v = self.settings.values
            if key in ("haptics", "hapticsLevel"):
                send_haptics(self.port, v["haptics"], v["hapticsLevel"])
            else:
                self.apply_lighting()

    # -- stdin commands ----------------------------------------------------
    def handle(self, line):
        try:
            msg = json.loads(line)
        except ValueError:
            self.error = "Ignored a command that was not JSON."
            return
        if not isinstance(msg, dict):
            return
        cmd = msg.get("cmd")
        try:
            if cmd == "set" and isinstance(msg.get("key"), str):
                self.set(msg["key"], msg.get("value"))
                self.error = self.settings.problem
            elif cmd == "refresh":
                if self.port:
                    self.poll()
                else:
                    self.last_open_try = 0.0
                    self.try_open()
            elif cmd == "fast" and isinstance(msg.get("value"), bool):
                self.fast = msg["value"]
                if self.fast and self.port:
                    self.next_poll = min(self.next_poll, time.monotonic() + 0.1)
            else:
                self.error = "Unknown command."
        except ValueError as e:
            self.error = str(e)
        except Unavailable as e:
            self.drop("The headset is not answering (%s). Turn it on, or replug the dongle if it stays like this." % e)
        except OSError as e:
            self.error = "Could not save settings: %s" % (e.strerror or e)

    def read_stdin(self):
        try:
            chunk = os.read(0, 4096)
        except BlockingIOError:
            return
        if not chunk:
            self.stop = True  # the shell went away
            return
        self.stdin_buf += chunk
        while b"\n" in self.stdin_buf:
            line, self.stdin_buf = self.stdin_buf.split(b"\n", 1)
            if len(line) <= MAX_STDIN_LINE:
                self.handle(line.decode("utf-8", "replace"))
        if len(self.stdin_buf) > MAX_STDIN_LINE:
            self.stdin_buf = b""

    # -- main loop ---------------------------------------------------------
    def run(self):
        os.set_blocking(0, False)
        self.try_open()
        self.emit(force=True)
        while not self.stop:
            if not self.port:
                self.try_open()
            waits = [1.0]
            if self.port:
                try:
                    if time.monotonic() >= self.next_poll:
                        self.poll()
                    if self.port:
                        nxt = self.effect_frame()
                        if nxt is not None:
                            waits.append(nxt)
                        self.port.pump()
                        self.port.events()  # acks and link events; nothing to act on
                        waits.append(max(0.0, self.next_poll - time.monotonic()))
                except Unavailable as e:
                    self.drop("The headset is not answering (%s). Turn it on, or replug the dongle if it stays like this." % e)
            self.emit()
            fds = [0] + ([self.port.fd] if self.port else [])
            try:
                r, _, _ = select.select(fds, [], [], max(0.0, min(waits)))
            except InterruptedError:
                continue
            if 0 in r:
                self.read_stdin()
        if self.port:
            self.port.close()


def take_lock():
    folder = private_dir(runtime_dir())
    fd = os.open(os.path.join(folder, "helper.lock"), os.O_RDWR | os.O_CREAT | os.O_CLOEXEC, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError as e:
        os.close(fd)
        if e.errno in (errno.EWOULDBLOCK, errno.EAGAIN):
            return None
        raise
    return fd


def main(argv):
    if len(argv) != 2 or argv[1] not in ("run", "status"):
        sys.stderr.write("usage: omakrakenctl run|status\n")
        return 2
    os.umask(0o077)
    lock = take_lock()
    if lock is None:
        print(json.dumps({"error": "Another OmaKraken helper is already using the headset."}))
        return 4
    if argv[1] == "run":
        signal.signal(signal.SIGTERM, lambda *a: (_ for _ in ()).throw(SystemExit(0)))
        runner = Runner()
        try:
            runner.run()
        finally:
            if runner.port:
                runner.port.close()
        return 0
    # status: one read, then exit
    runner = Runner(apply=False)
    runner.last_open_try = -RETRY_SECONDS
    runner.try_open()
    print(json.dumps(runner.status(), sort_keys=True, indent=2))
    if runner.port:
        runner.port.close()
    return 0 if runner.state else 3


if __name__ == "__main__":
    sys.exit(main(sys.argv))
